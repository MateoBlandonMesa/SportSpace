{
  "name": "sportspace",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w @sportspace/api",
    "dev:web": "npm run dev -w @sportspace/web",
    "build:api": "npm run build -w @sportspace/api",
    "build:web": "npm run build -w @sportspace/web",
    "prisma:generate": "npm run prisma:generate -w @sportspace/api",
    "prisma:migrate": "npm run prisma:migrate -w @sportspace/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  }
}
