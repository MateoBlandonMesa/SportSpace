{
  "info": {
    "_postman_id": "sportspace-api-local",
    "name": "SportSpace API",
    "description": "Peticiones locales de SportSpace. Importar en Postman (File → Import). Variable `baseUrl`: http://localhost:3000. Tras crear un espacio, `spaceId` se guarda solo. Actualizar esta colección en el mismo PR cuando cambie un endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "spaceId",
      "value": "00000000-0000-4000-8000-000000000000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Comprueba que la API está viva. Esperado: `{ \"status\": \"ok\" }`."
          }
        }
      ]
    },
    {
      "name": "Auth (stub — Carlos)",
      "item": [
        {
          "name": "GET auth status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/status",
            "description": "Placeholder hasta feat/auth. Esperado: implemented false."
          }
        }
      ]
    },
    {
      "name": "Users (stub — Carlos)",
      "item": [
        {
          "name": "GET users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users",
            "description": "Lista de usuarios (ADMIN). Hoy el guard es stub y responde []. feat/auth y feat/roles la completan."
          }
        }
      ]
    },
    {
      "name": "Spaces (Dilan)",
      "item": [
        {
          "name": "GET spaces (catalog)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/spaces",
            "description": "Solo espacios activos. Catálogo vacío = `[]`."
          }
        },
        {
          "name": "GET spaces filtered",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/spaces?campus=Ciudad Universitaria&type=pista",
            "description": "Filtros HU-08 (Should): campus y type."
          }
        },
        {
          "name": "POST space",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.id) {",
                  "    pm.collectionVariables.set('spaceId', body.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pista sintetica\",\n  \"type\": \"pista\",\n  \"campus\": \"Ciudad Universitaria\",\n  \"capacity\": 40,\n  \"usageRules\": \"Uso con reserva previa\"\n}"
            },
            "url": "{{baseUrl}}/api/spaces",
            "description": "Crea un espacio activo. Guarda `id` en la variable spaceId."
          }
        },
        {
          "name": "GET space by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/spaces/{{spaceId}}",
            "description": "Detalle. Ejecutar POST space antes o pegar un UUID. 404 si no existe."
          }
        },
        {
          "name": "GET space not found",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/spaces/00000000-0000-4000-8000-000000000000",
            "description": "Esperado: 404 Space not found."
          }
        },
        {
          "name": "PATCH space (edit)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"capacity\": 50,\n  \"usageRules\": \"Reserva con 24 horas de anticipacion\"\n}"
            },
            "url": "{{baseUrl}}/api/spaces/{{spaceId}}",
            "description": "Edita campos. Usa spaceId de POST space."
          }
        },
        {
          "name": "PATCH space (deactivate)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": "{{baseUrl}}/api/spaces/{{spaceId}}",
            "description": "Desactiva. El GET catalog ya no debe listarlo."
          }
        }
      ]
    },
    {
      "name": "Availability (stub — Dilan)",
      "item": [
        {
          "name": "GET availability by space",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/spaces/{{spaceId}}/availability",
            "description": "Placeholder feat/availability. Hoy responde []."
          }
        }
      ]
    },
    {
      "name": "Reservations (stub — Dilan)",
      "item": [
        {
          "name": "GET my reservations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reservations",
            "description": "Placeholder. Hoy responde []."
          }
        },
        {
          "name": "POST reservation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/reservations",
            "description": "Placeholder feat/reservations. Hoy: implemented false."
          }
        }
      ]
    }
  ]
}
