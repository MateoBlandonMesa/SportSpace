{
  "info": {
    "_postman_id": "sportspace-api-local",
    "name": "SportSpace API",
    "description": "Importar en Postman. baseUrl=http://localhost:3000. Login guarda accessToken. POST space guarda spaceId. Las rutas de spaces/reservas llevan Bearer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "spaceId", "value": "00000000-0000-4000-8000-000000000000" },
    { "key": "reservationId", "value": "00000000-0000-4000-8000-000000000000" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Estudiante\",\n  \"email\": \"ana.estudiante@udea.edu.co\",\n  \"password\": \"Clave1234\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "POST login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana.estudiante@udea.edu.co\",\n  \"password\": \"Clave1234\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "POST login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@udea.edu.co\",\n  \"password\": \"Admin1234\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Tras `npm run prisma:seed`."
          }
        },
        {
          "name": "POST refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/refresh",
            "description": "Usa cookie refreshToken del login. En Postman activa cookie jar."
          }
        },
        {
          "name": "GET profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/auth/profile"
          }
        },
        {
          "name": "POST logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "GET users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/users",
            "description": "Solo ADMIN. Hoy responde []."
          }
        }
      ]
    },
    {
      "name": "Spaces",
      "item": [
        {
          "name": "GET spaces (catalog)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/spaces"
          }
        },
        {
          "name": "GET spaces filtered",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/spaces?campus=Ciudad Universitaria&type=pista"
          }
        },
        {
          "name": "POST space",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.id) pm.collectionVariables.set('spaceId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pista sintetica\",\n  \"type\": \"pista\",\n  \"campus\": \"Ciudad Universitaria\",\n  \"capacity\": 40,\n  \"usageRules\": \"Uso con reserva previa\"\n}"
            },
            "url": "{{baseUrl}}/api/spaces"
          }
        },
        {
          "name": "GET space by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/spaces/{{spaceId}}"
          }
        },
        {
          "name": "GET space not found",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/spaces/00000000-0000-4000-8000-000000000000"
          }
        },
        {
          "name": "PATCH space (edit)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"capacity\": 50,\n  \"usageRules\": \"Reserva con 24 horas de anticipacion\"\n}"
            },
            "url": "{{baseUrl}}/api/spaces/{{spaceId}}"
          }
        },
        {
          "name": "PATCH space (deactivate)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": "{{baseUrl}}/api/spaces/{{spaceId}}"
          }
        }
      ]
    },
    {
      "name": "Availability",
      "item": [
        {
          "name": "GET availability by space",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/spaces/{{spaceId}}/availability?date=2026-10-13",
            "description": "Franjas de 60 min en America/Bogota. status: FREE | BUSY | BLOCKED | PAST. Requiere date=YYYY-MM-DD."
          }
        },
        {
          "name": "GET availability past date",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/spaces/{{spaceId}}/availability?date=2026-10-01",
            "description": "Fecha pasada: franjas con status PAST y bookable=false."
          }
        },
        {
          "name": "PUT weekly hours",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"daysOfWeek\": [1, 2, 3, 4, 5],\n  \"startTime\": \"06:00\",\n  \"endTime\": \"22:00\"\n}"
            },
            "url": "{{baseUrl}}/api/spaces/{{spaceId}}/availability/weekly-hours",
            "description": "STAFF/ADMIN. daysOfWeek 1=lunes … 7=domingo. Reemplaza el horario semanal del espacio."
          }
        },
        {
          "name": "POST block",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startsAt\": \"2026-10-13T09:00:00-05:00\",\n  \"endsAt\": \"2026-10-13T12:00:00-05:00\",\n  \"reason\": \"mantenimiento\"\n}"
            },
            "url": "{{baseUrl}}/api/spaces/{{spaceId}}/availability/blocks",
            "description": "STAFF/ADMIN. Bloquea un intervalo; esas franjas salen BLOCKED."
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "GET my reservations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/reservations",
            "description": "STUDENT ve solo las suyas. STAFF/ADMIN ven todas (hasta 100)."
          }
        },
        {
          "name": "POST reservation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.id) pm.collectionVariables.set('reservationId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spaceId\": \"{{spaceId}}\",\n  \"startsAt\": \"2026-10-14T08:00:00-05:00\",\n  \"endsAt\": \"2026-10-14T10:00:00-05:00\"\n}"
            },
            "url": "{{baseUrl}}/api/reservations",
            "description": "Crea PENDING. Intervalo alineado a franjas de 60 min. Solape → 409."
          }
        },
        {
          "name": "POST reservation overlap",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spaceId\": \"{{spaceId}}\",\n  \"startsAt\": \"2026-10-14T08:00:00-05:00\",\n  \"endsAt\": \"2026-10-14T10:00:00-05:00\"\n}"
            },
            "url": "{{baseUrl}}/api/reservations",
            "description": "Misma franja que POST reservation; debe responder 409."
          }
        },
        {
          "name": "POST cancel reservation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}/cancel"
          }
        },
        {
          "name": "POST approve reservation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}/approve",
            "description": "STAFF/ADMIN. PENDING → APPROVED."
          }
        },
        {
          "name": "POST reject reservation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Evento institucional\"\n}"
            },
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}/reject",
            "description": "STAFF/ADMIN. PENDING → REJECTED. Motivo obligatorio."
          }
        }
      ]
    },
    {
      "name": "Occupancy",
      "item": [
        {
          "name": "GET occupancy week",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/occupancy?weekStart=2026-10-12",
            "description": "STAFF/ADMIN. Semana lunes–domingo America/Bogota. weekStart se normaliza al lunes."
          }
        },
        {
          "name": "GET occupancy by space",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/occupancy?weekStart=2026-10-12&spaceId={{spaceId}}"
          }
        }
      ]
    }
  ]
}
